#Docker配置文件
Dockerfile

# 本地文档参考内容
docs/*
picture/*
reference/*
*.md
!readme.md

# 本地日志，编译，安装文件
log/*
build/*
install/*

# pixi 环境
.pixi/*
!.pixi/config.toml


# 模型权重
*.pt
*.task

# Cursor 和Coding Agent本地配置
.cursorignore
.cursorrules
.cursor/*
.claude/*

# training目录中的训练数据和模型权重都不保存，但保存文件夹结构
training/**
!training/**/
!training/**/.gitkeep