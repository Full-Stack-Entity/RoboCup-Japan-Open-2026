<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_ros2</name>
  <version>0.1.0</version>
  <description>Vision package with YOLOv12 object detection — ROS 2 Humble migration</description>

  <maintainer email="mahmoud@todo.todo">mahmoud</maintainer>
  <license>AGPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>python3-tf-transformations</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
