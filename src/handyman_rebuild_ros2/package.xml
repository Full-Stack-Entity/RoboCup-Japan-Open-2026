<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>handyman_rebuild_ros2</name>
  <version>0.1.0</version>
  <description>Modular Handyman controller scaffold for RoboCup@Home Simulation.</description>
  <maintainer email="maintainer@example.com">RoboCup Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>boost</depend>
  <depend>rclcpp</depend>
  <depend>handyman_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>yaml_cpp_vendor</depend>

  <exec_depend>handyman_ros2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>sigverse_ros_bridge</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>nav2_map_server</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
