<?xml version="1.0"?>
<package format="3">
  <name>human_nav_ros2</name>
  <version>0.0.1</version>
  <description>ROS2 port of Human Navigation sample (from HumanNavigation-2025)</description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>BSD-3-Clause</license>

  <!-- 构建系统 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 运行/构建依赖：与代码中 include/类型对应 -->
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>human_navigation_msgs</depend>
  <depend>human_nav_llm_ros2</depend>

  <!-- sample_with_rviz_launch 会启动 rviz2，需声明执行依赖 -->
  <exec_depend>rviz2</exec_depend>

  <!-- 为了让 colcon 生成可执行文件信息 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>